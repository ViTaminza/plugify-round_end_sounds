{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${ROUND_END_SOUNDS_VERSION}",
	"name": "round_end_sounds",
	"description": "Music at the end of the round, ported from the Metamod:Source plugin cs2-round-end-sounds (itself a port of Stimayk/RoundEndSounds). Plays one track per round end (random without repeats or in order) to every player who wants it, at his own volume, with a preview menu ('!res'), and mutes the win/lose music and the MVP anthem of the players' music kits while the track is on. Reads configs/round_end_sounds/round_end_sounds.ini (the live server's fleet config: 100 Alko.Track.* soundevents of workshop addon 3811020435) and configs/round_end_sounds/translations/round_end_sounds.phrases.txt; per-player switch and volume live in the official permissions cookies under the Metamod names (RES.Enabled / RES.Volume). Per-player volume of the soundevents is applied with GE_SosSetSoundEventParams. No exported methods.",
	"author": "E!N, Stimayk, Metamod port; ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/round_end_sounds",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "permissions",
			"constraints": ">=1.3.1",
			"optional": true
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
